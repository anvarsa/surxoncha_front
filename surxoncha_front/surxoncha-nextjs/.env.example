# ---- Public site ----
NEXT_PUBLIC_SITE_URL=https://surxoncha.uz
NEXT_PUBLIC_SITE_NAME=Surxoncha.uz

# ---- Strapi CMS ----
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=replace_with_read_token
STRAPI_MEDIA_HOSTNAME=cms.surxoncha.uz
# Client-side (browser) uchun — rasm preview'lari kabi joylarda ishlatiladi.
# Odatda STRAPI_URL bilan bir xil, lekin public bo'lgani uchun alohida yozilgan.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# ---- Database (Strapi side, PostgreSQL) ----
DATABASE_URL=postgresql://user:password@localhost:5432/surxoncha
DATABASE_SSL=false

# ---- Auth (NextAuth / custom JWT) ----
AUTH_SECRET=replace_with_long_random_string
AUTH_URL=http://localhost:3000

# ---- On-demand revalidation (7-qism) ----
# Strapi'dagi trigger-revalidate.js shu qiymatlarni ishlatadi.
# REVALIDATE_SECRET Next.js va Strapi'da BIR XIL bo'lishi shart.
REVALIDATE_SECRET=replace_with_long_random_string
NEXT_REVALIDATE_URL=http://localhost:3000/api/revalidate

# ---- S3-compatible object storage ----
STORAGE_ENDPOINT=https://s3.eu-central-1.amazonaws.com
STORAGE_PUBLIC_HOSTNAME=cdn.surxoncha.uz
STORAGE_ACCESS_KEY=replace_me
STORAGE_SECRET_KEY=replace_me
STORAGE_BUCKET=surxoncha-media
STORAGE_REGION=eu-central-1

# ---- Analytics ----
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- Future: Telegram auto-publish ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
