{
  "kind": "collectionType",
  "collectionName": "contributor_applications",
  "info": {
    "singularName": "contributor-application",
    "pluralName": "contributor-applications",
    "displayName": "Contributor Application"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "applicant": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "fullName": { "type": "string", "required": true },
    "region": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::region.region"
    },
    "experience": { "type": "text", "required": true },
    "specialization": { "type": "json" },
    "portfolioUrl": { "type": "string" },
    "motivation": { "type": "text", "required": true },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "approved", "rejected"],
      "default": "pending",
      "required": true
    },
    "reviewNote": { "type": "text" }
  }
}
